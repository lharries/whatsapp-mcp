<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kodi.whatsapp-bridge-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kodikaraste/Projects/whatsapp-mcp/whatsapp-bridge/watchdog.sh</string>
    </array>

    <!-- lsof lives in /usr/sbin, launchctl in /bin, curl in /usr/bin. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Probe /health every 15s. With THRESHOLD=2 in watchdog.sh that means a
         wedge is detected and force-restarted within ~30s, recovered well under
         a minute. Do NOT add KeepAlive: this is a periodic job, not a daemon. -->
    <key>StartInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/tmp/whatsapp-bridge-watchdog.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/whatsapp-bridge-watchdog.err</string>
</dict>
</plist>
