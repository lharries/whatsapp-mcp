# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_PORT=8080
HOST=0.0.0.0

# Data Store Configuration
DATA_STORE_TYPE=json
# JSON Store
JSON_STORE_PATH=./data/json

# SQLite Store (optional)
# SQLITE_DB_PATH=./data/whatsapp.db

# MongoDB Store (optional)
# MONGODB_URI=mongodb://localhost:27017/whatsapp_mcp

# WhatsApp Configuration
WHATSAPP_AUTH_PATH=./data/auth
WHATSAPP_MEDIA_PATH=./data/media

# MCP Server Configuration
MCP_SERVER_NAME=whatsapp-mcp-server
MCP_SERVER_VERSION=2.0.0
MCP_TRANSPORT_TYPE=stdio
# For SSE transport
MCP_SSE_PORT=3001

# API Configuration
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication (for future use)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_DELAY=5000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
# LOG_FILE=./logs/app.log

# Media Processing
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1920
AUDIO_BITRATE=32k
AUDIO_SAMPLE_RATE=24000
