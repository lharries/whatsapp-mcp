# Per-account bridge configuration.
# Copy to /etc/whatsapp-mcp/<account>.env (e.g. /etc/whatsapp-mcp/main.env).

WA_ACCOUNT=main
# Each account process needs its own port (main 8080, second 8081, ...).
WA_PORT=8080
# WA_DB_DIR is set by the systemd unit to /var/lib/whatsapp-mcp/<account>.

# Shared secret required on every /api/* and /pair request (empty = loopback
# trust only). Generate with: openssl rand -hex 32
WA_TOKEN=

# POST every inbound message here (an agent / queue), signed with HMAC-SHA256 in
# the X-WA-Signature header when WEBHOOK_SECRET is set.
WEBHOOK_URL=
WEBHOOK_SECRET=

# Your own JID for this account, used by the reply-approval loop.
WA_OWNER_JID=
