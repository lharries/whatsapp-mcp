{
  "name": "WhatsApp MCP private archive",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && cd whatsapp-mcp-server && ~/.local/bin/uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-python.python"
      ]
    }
  }
}
