# Shared secret between the whatsapp-bridge and whatsapp-mcp services.
# The bridge is fail-closed: it refuses to start without this variable set,
# and it will not start with an empty value either.
#
# Generate a strong token (any of these work):
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Copy this file to `.env` (which is gitignored) and paste the generated
# value below. Never commit the real .env file or the token in plain text
# anywhere else (issue trackers, chat, CI logs).
WHATSAPP_BRIDGE_TOKEN=
